{
  "name": "acompanhamento-politico",
  "version": "0.1.0",
  "description": "Newsletter diária sobre votações de leis no Congresso Nacional: quem votou a favor, contra e quem não registrou voto.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm migration:generate ./src/shared/database/migrations/$npm_config_name -- -d ./src/config/dataSource.ts",
    "migration:create": "npm run typeorm migration:create ./src/shared/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm migration:run -- -d ./src/config/dataSource.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d ./src/config/dataSource.ts",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d ./dist/src/config/dataSource.js",
    "migration:run:prod": "npm run typeorm:prod migration:run",
    "ingest": "ts-node -r tsconfig-paths/register ./src/legislative/scripts/ingest.script.ts",
    "ingest:prod": "node ./dist/src/legislative/scripts/ingest.script.js",
    "digest:send": "ts-node -r tsconfig-paths/register ./src/newsletter/scripts/send-digest.script.ts",
    "digest:send:prod": "node ./dist/src/newsletter/scripts/send-digest.script.js",
    "db:seed": "ts-node -r tsconfig-paths/register ./src/shared/database/seeds/seeds.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
