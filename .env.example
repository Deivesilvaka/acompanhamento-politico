# Copie para .env e preencha. NUNCA versione o .env.
# Em produção, injete os segredos via Azure Key Vault / Google Secret Manager.

NODE_ENV=local
APP_PORT=3000
APP_NAME="Acompanhamento Político"

# URL pública (usada nos links dos e-mails). Em produção DEVE ser https.
PUBLIC_URL=http://localhost:3000

# Número de proxies confiáveis à frente da API (0 = acesso direto).
# Necessário para o rate limit enxergar o IP real atrás de load balancer.
TRUST_PROXY_HOPS=0

# Segredo HMAC dos links de cancelamento. Mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
UNSUBSCRIBE_TOKEN_SECRET=

# Banco
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
# Gere uma senha forte; o docker-compose usa esta mesma variável.
DB_PASSWORD=
DB_NAME=acompanhamento_politico
DB_SSL=false

# E-mail. Local: Mailpit do docker-compose (caixa em http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
# true = TLS implícito (porta 465). false = STARTTLS obrigatório (porta 587).
MAIL_SECURE=false
# Aceita certificado autoassinado (Mailpit). PROIBIDO em produção: a API não sobe.
MAIL_ALLOW_SELF_SIGNED=true
MAIL_USER=dev
MAIL_PASSWORD=dev
# Limite de envios por segundo (ajuste ao plano do seu provedor SMTP).
MAIL_MAX_PER_SECOND=10
MAIL_SENDER_DEFAULT="no-reply@example.com"
MAIL_SENDER_NAME_DEFAULT="Acompanhamento Político"

# Agendamentos (fuso America/Sao_Paulo)
# Busca de leis, votos e ausências à noite (18h e 23h, para pegar sessões que vão até tarde).
INGESTION_CRON="0 18,23 * * *"
# Envio diário a partir das 5h.
DIGEST_CRON="0 5 * * *"
# Retoma envios com falha temporária a cada 15 min, das 5h às 17h (fora da janela de ingestão).
DIGEST_RETRY_CRON="*/15 5-17 * * *"
# Quantos dias para trás a ingestão diária reconsulta (dados oficiais podem chegar atrasados)
INGESTION_LOOKBACK_DAYS=1

# AI

# Observações editoriais por IA no resumo diário.
# live = Groq (com busca na web) e, se falhar, NVIDIA. mock = texto simulado, sem custo. off = sem observações.
AI_OBSERVATIONS_MODE=mock
# Tempo máximo por chamada de IA (segundos). Um modelo travado nunca segura o envio.
AI_TIMEOUT_SECONDS=120
# Espera máxima quando a IA pede para aguardar (limite por minuto do plano gratuito).
AI_MAX_WAIT_SECONDS=300
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
NVIDIA_API_KEY=
# Aceita lista em ordem de preferência, separada por vírgula.
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3-ultra-550b-a55b,openai/gpt-oss-20b
